# Runtime uses a dedicated restricted role. Migration uses a distinct schema owner.
CARRIER_DATABASE_URL=postgresql://carrier_role:replace-me@host:5432/database
CARRIER_MIGRATION_DATABASE_URL=postgresql://carrier_schema_owner:replace-me@host:5432/database
CARRIER_RUNTIME_ROLE=carrier_role
WHP_MARKET_ORIGIN=https://your-whp-market.example

# Optional long-running mode settings. Railway Cron should use `npm run run:once`.
PORT=3000
CARRIER_RUN_IMMEDIATELY=true
CARRIER_MAX_AUTOMATED_CONTACTS=500
CARRIER_REGISTRY_PAGES=3

# Emergency, fail-closed operator switch.
CARRIER_DISABLED=false
