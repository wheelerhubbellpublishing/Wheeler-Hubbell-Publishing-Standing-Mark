# Required. Use a Base mainnet JSON-RPC endpoint and a PostgreSQL connection.
BASE_RPC_URL=https://mainnet.base.org
DATABASE_URL=postgresql://user:password@host:5432/database

# Continuous-service settings.
PORT=3000
POLL_INTERVAL_MS=5000
RPC_BLOCK_RANGE=2000

# Optional. If omitted on a new database, observation starts after the current
# finalized block. Set an explicit block to backfill from that block inclusive.
# START_BLOCK=35000000

# Hosted PostgreSQL commonly requires TLS. Values: require, disable.
DATABASE_SSL_MODE=require

# Optional notification after the event and cursor are durable in PostgreSQL.
# Delivery is at least once. Receivers should deduplicate by the Idempotency-Key.
# WEBHOOK_URL=https://example.com/whp-settlement
# WEBHOOK_BEARER_TOKEN=replace-me
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_BATCH_SIZE=20
